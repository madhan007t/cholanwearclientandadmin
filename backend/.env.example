# ---------- Server ----------
NODE_ENV=development
PORT=5000

# ---------- Database ----------
# Local MongoDB:  mongodb://127.0.0.1:27017/cholanwear
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>/cholanwear?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://madhanraj:Madhan007@cluster0.jpze5xz.mongodb.net/cholanwear?retryWrites=true&w=majority&cholanwear=Cluster0
# Dev convenience ONLY: if MONGODB_URI is empty and this is true, a local mongod binary is
# downloaded/started automatically (data persisted in backend/.mongo-data). Never use in production.
USE_MEMORY_DB=false

# ---------- Auth ----------
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# lax = frontend and API on the same site (or through the Vite proxy / SERVE_FRONTEND).
# none = frontend and API on different sites (requires HTTPS; COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ---------- CORS ----------
# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ---------- Uploads ----------
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---------- Single-service deployment ----------
# true = Express also serves frontend/dist (run `npm run build` in /frontend first)
SERVE_FRONTEND=false

# ---------- Admin seed (used by `npm run seed:admin` / `npm run seed`) ----------
ADMIN_NAME=CHOLAN Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
